# أصل الباك إند فقط — لا تضف /api أو endpoint إلى القيمة.
VITE_API_BASE_URL="https://ziadkamalaln2842-001-site1.etempurl.com"

# اختياري — تتبّع الأخطاء (Sentry). الـDSN مو سر (آمن بالكود الجاهز)، فحطيت
# قيمة مشروعكم الفعلي كـfallback جوا src/instrument.client.ts وsrc/server.ts
# — عرّف هالمتغير بس لو بدك تفصل DSN مختلف (بيئة staging مثلاً).
VITE_SENTRY_DSN=""
# اختياري (وقت البناء فقط) — لرفع source maps تلقائيًا لـSentry. بدون
# SENTRY_AUTH_TOKEN، البلوجن ما بينضاف للبناء إطلاقًا (راجع vite.config.ts).
# التوكن هذا سرّي — لا تحطه بـ.env المرفوع لأي مكان عام، هون بس للتوثيق.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="voidunemployed"
SENTRY_PROJECT="javascript-tanstackstart-react"

# اختياري — تتبّع الاستخدام عبر PostHog. بدون قيمة، initAnalytics() ما
# بتعمل شي (راجع src/lib/analytics.ts). احصل على المفتاح من مشروعك بـPostHog
# (posthog.com) — الخطة المجانية كافية للبداية.
VITE_POSTHOG_KEY=""
# افتراضيًا سيرفر أوروبا (eu.i.posthog.com) — بدّلها لـ us.i.posthog.com لو
# اخترت منطقة أمريكا عند إنشاء المشروع بـPostHog.
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
