# الموصى به: اتركه فاضيًا (""). طلبات /api/* بتمرّ عبر بروكسي على نفس دومين
# الموقع (Nitro routeRules بالإنتاج، Vite proxy بالتطوير) فالكوكي first-party
# وما في CORS ولا حجب كوكيز طرف ثالث. عنوان الباك اند الفعلي للبروكسي بيتحدد
# بمتغير API_PROXY_TARGET (افتراضيًا سيرفر etempurl، راجع vite.config.ts).
# لو حطيت رابط كامل بدل الفاضي بتصير الطلبات مباشرة cross-origin — لازم CORS
# والكوكي (SameSite=None) يكونوا مضبوطين بالباك اند، وتنحجب بمتصفحات بتمنع
# كوكيز الطرف الثالث. أصل الباك إند فقط — لا تضف /api للقيمة.
VITE_API_BASE_URL=""
# API_PROXY_TARGET="https://localhost:7176"

# منصة النشر (تحدد preset بناء Nitro — راجع vite.config.ts). القيمة
# الافتراضية "vercel" لو ما عرّفت المتغير، فتعريفه هون اختياري بالأساس —
# بس صريح أوضح من الاعتماد على القيمة الافتراضية بالكود لوحدها.
NITRO_PRESET="vercel"

# اختياري — الرابط الأساسي للموقع (يُستخدم بـ sitemap.xml ووسوم SEO
# canonical/og). بدونه بيستخدم رابط Vercel الافتراضي (راجع src/lib/env.ts).
VITE_SITE_URL=""

# دخول تجريبي بدون باك اند حقيقي (أزرار "دخول سريع" بصفحة /login) — شغّال
# دائمًا بالتطوير المحلي (npm run dev) بغض النظر عن هالقيمة. فعّلها هون بس
# لو بدك تتيحه بنشر preview/staging كمان.
VITE_ENABLE_DEMO_LOGIN="false"

# يُظهر/يُخفي صفحة التسجيل (/signup). خليها "false" لحد ما يجهز endpoint
# التسجيل الحقيقي بالباك اند.
VITE_ENABLE_SIGNUP="false"

# اختياري — تتبّع الأخطاء (Sentry). الـDSN مو سر (آمن بالكود الجاهز)، فحطيت
# قيمة مشروعكم الفعلي كـfallback جوا src/instrument.client.ts وsrc/server.ts
# — عرّف هالمتغير بس لو بدك تفصل DSN مختلف (بيئة staging مثلاً).
VITE_SENTRY_DSN=""
# اختياري (وقت البناء فقط) — لرفع source maps تلقائيًا لـSentry. بدون
# SENTRY_AUTH_TOKEN، البلوجن ما بينضاف للبناء إطلاقًا (راجع vite.config.ts).
# التوكن هذا سرّي — لا تحطه بـ.env المرفوع لأي مكان عام، هون بس للتوثيق.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="voidunemployed"
SENTRY_PROJECT="javascript-tanstackstart-react"

# اختياري — تتبّع الاستخدام عبر PostHog. بدون قيمة، initAnalytics() ما
# بتعمل شي (راجع src/lib/analytics.ts). احصل على المفتاح من مشروعك بـPostHog
# (posthog.com) — الخطة المجانية كافية للبداية.
VITE_POSTHOG_KEY=""
# افتراضيًا سيرفر أوروبا (eu.i.posthog.com) — بدّلها لـ us.i.posthog.com لو
# اخترت منطقة أمريكا عند إنشاء المشروع بـPostHog.
VITE_POSTHOG_HOST="https://eu.i.posthog.com"
