+  });
+
+  const statusMutation = useMutation({
+    mutationFn: (vars: { row: TeacherVerificationRow; status: TeacherVerificationStatus }) =>
+      persist({ data: { ...vars.row, status: vars.status, notes: vars.row.notes ?? "" } }),
+    onSuccess: () => {
