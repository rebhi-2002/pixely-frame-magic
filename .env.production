# قيم غير سرية تُقرأ تلقائيًا بـ`vite build` (وضع production) — بتضمن نشرًا
# ثابتًا حتى لو ما انضبطت متغيرات بيئة بلوحة Vercel. أي قيمة تانية عرّفها
# بلوحة Vercel بتتفوّق على هالملف.
#
# فاضي = طلبات /api/* بتروح لنفس دومين الموقع وVercel/Nitro بيمرّرها للباك اند
# (راجع vite.config.ts → routeRules). هيك الكوكي first-party وما في CORS.
VITE_API_BASE_URL=""
VITE_ENABLE_SIGNUP="true"
VITE_ENABLE_DEMO_LOGIN="true"
