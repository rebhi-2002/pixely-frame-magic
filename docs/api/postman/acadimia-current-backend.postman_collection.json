              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"returnUrl\": null\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                    "const json = pm.response.json();",
                    "pm.test(\"OperationResult is present\", function () { pm.expect(json).to.have.property(\"success\"); });",
                    "if (json.success) pm.environment.set(\"loginSuccess\", \"true\");"
                  ]
                }
              }
            ]
          },
          "response": []
        },
